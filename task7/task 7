result = merge_contacts([phone1, phone2])

print("Merged Contacts:")

for phone, details in result.items():
    print("\nPhone:", phone)
    print("Names:", details["names"])
    print("Numbers:", details["numbers"])
    print("Emails:", details["emails"])


# Performance testing

for n in (1000, 100000):

    contacts = [
        {
            "name": f"Person {i}",
            "phone": str(9000000000 + i)
        }
        for i in range(n)
    ]

    start = time.perf_counter()

    merged = merge_contacts([contacts])

    end = time.perf_counter()

    print("\nNumber of contacts:", n)
    print("Execution time:", round(end - start, 6), "seconds")
    print("Merged contacts:", len(merged))